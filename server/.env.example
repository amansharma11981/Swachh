PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=2h
COOKIE_NAME=swachhai_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
REPORT_MAX_IMAGE_SIZE_BYTES=5242880
REPORT_ZONES=nit-more-street-food-lane=NIT More Street-Food Lane;ashok-rajpath=Ashok Rajpath construction/barrier zone;nit-gandhi-ghat=NIT / Gandhi Ghat
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, server-only Groq. Explicitly analyzed report photos and up to 500
# description characters, submitted civic-assistant chat text, and aggregate-only
# admin insight metrics are sent to Groq for those user-triggered features.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Set these only when explicitly running npm run seed:admin; remove them afterward.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
