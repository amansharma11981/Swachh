# Public frontend configuration only. Never put secrets here.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_REPORT_MAX_IMAGE_SIZE_BYTES=5242880
VITE_MAP_CENTER_LAT=25.62
VITE_MAP_CENTER_LNG=85.17
# Optional compatible tile endpoint; keep visible OpenStreetMap attribution in the UI.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
